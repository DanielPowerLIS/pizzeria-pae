<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import java.lang.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox prefHeight="743.0" prefWidth="1500.0" spacing="20.0" style="-fx-background-color: #505050;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pizzeria.pae.vistas.controlador.PedidosViewController">
   <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
   <children>
      <Label text="Módulo de Pedidos" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <HBox>
               <children>
                  <TextField fx:id="txtBuscarUsuario" prefHeight="37.0" prefWidth="318.0" promptText="Buscar por nombre, dirección o teléfono..." style="-fx-background-color: #323232; -fx-text-fill: white;" />
                  <Button fx:id="btnBuscarUsuario" style="-fx-background-color: transparent; -fx-background-radius: 8;" textFill="WHITE">
                     <graphic>
                        <ImageView fitHeight="26.0" fitWidth="165.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../resources/icons/icon-buscar.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </HBox>
            <DatePicker fx:id="dpBuscarFecha" promptText="Fecha de pedido..." />
            <ComboBox fx:id="cmbBuscarEstatus" prefWidth="150.0" promptText="Estatus..." />
            <Button fx:id="btnNuevoPedido" onAction="#clickNuevoPedido" prefHeight="40" prefWidth="130" style="-fx-background-color: #218c74; -fx-background-radius: 8;" text="Nuevo Pedido" textFill="WHITE" />
            <Button fx:id="btnEditarPedido" onAction="#clickEditarPedido" prefHeight="40" prefWidth="130" style="-fx-background-color: #404040; -fx-background-radius: 8;" text="Editar Pedido" textFill="WHITE" />
            <Button fx:id="btnCambiarEstatus" onAction="#clickCambiarEstatus" prefHeight="40" prefWidth="140" style="-fx-background-color: #404040; -fx-background-radius: 8;" text="Cambiar Estatus" textFill="WHITE" />
            <Region HBox.hgrow="ALWAYS" />
            
            <MenuButton fx:id="btnMenuExportar" prefHeight="40" style="-fx-background-color: #227093; -fx-background-radius: 8;" text="Exportar..." textFill="WHITE">
              <items>
                <MenuItem fx:id="menuItemExportarCSV" text="Exportar a CSV" />
                <MenuItem fx:id="menuItemExportarPDF" text="Exportar a PDF" />
              </items>
            </MenuButton>
            
         </children>
      </HBox>
      <TableView fx:id="tvPedidos" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="tcFolio" prefWidth="80.0" text="Folio" />
            <TableColumn fx:id="tcFecha" prefWidth="150.0" text="Fecha" />
            <TableColumn fx:id="tcCliente" prefWidth="250.0" text="Cliente" />
            <TableColumn fx:id="tcTotalPedido" prefWidth="100.0" text="Total ($)" />
            <TableColumn fx:id="tcEstatus" prefWidth="150.0" text="Estatus" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_RIGHT" spacing="15.0" />
   </children>
</VBox>
