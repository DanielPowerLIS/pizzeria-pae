<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import java.lang.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="743.0" prefWidth="1386.0" spacing="20.0" style="-fx-background-color: #505050;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pizzeria.pae.vistas.controlador.UsuariosViewController">
   <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
   <children>
      <Label text="Gestión de Usuarios" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <HBox>
               <children>
                  <TextField fx:id="txtBuscarUsuario" prefHeight="37.0" prefWidth="318.0" promptText="Buscar por nombre, dirección o teléfono..." style="-fx-background-color: #323232; -fx-text-fill: white;" />
                  <Button fx:id="btnBuscarUsuario" style="-fx-background-color: transparent; -fx-background-radius: 8;" textFill="WHITE">
                     <graphic>
                        <ImageView fitHeight="26.0" fitWidth="165.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../resources/icons/icon-buscar.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </HBox>
            <Button fx:id="btnAgregarUsuario" prefHeight="40" prefWidth="141.0" style="-fx-background-color: #404040; -fx-background-radius: 8;" text="Agregar Usuario" textFill="WHITE" />
            <Button fx:id="btnEditarUsuario" prefHeight="40" prefWidth="141.0" style="-fx-background-color: #404040; -fx-background-radius: 8;" text="Editar Usuario" textFill="WHITE" />
            <Button fx:id="btnEliminarUsuario" prefHeight="40" prefWidth="141.0" style="-fx-background-color: #a83232; -fx-background-radius: 8;" text="Eliminar Usuario" textFill="WHITE" />
         </children>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="30.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="25.0" style="-fx-background-color: #555555; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
               </padding>
               <children>
                  <RadioButton fx:id="rdTodos" mnemonicParsing="false" selected="true" text="Todos" textFill="WHITE">
                     <toggleGroup>
                        <ToggleGroup fx:id="tgFiltroUsuarios" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="rdEmpleados" mnemonicParsing="false" text="Empleados" textFill="WHITE" toggleGroup="$tgFiltroUsuarios" />
                  <RadioButton fx:id="rdClientes" mnemonicParsing="false" text="Clientes" textFill="WHITE" toggleGroup="$tgFiltroUsuarios" />
               </children>
            </HBox>
         </children>
      </HBox>

      <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre y Apellidos" />
            <TableColumn fx:id="colTelefono" prefWidth="150.0" text="Teléfono" />
            <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
            <TableColumn fx:id="colDireccion" prefWidth="250.0" text="Dirección" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
