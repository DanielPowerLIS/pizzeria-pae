<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="743.0" prefWidth="1386.0" spacing="20.0" style="-fx-background-color: #505050;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pizzeria.pae.vistas.controlador.ValidacionInventarioViewController">
   <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
   <children>
      <Label text="Validación de Inventario Físico" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label text="Capture la cantidad física actual para comparar con la registrada en el sistema." textFill="#d1cfcf" />
      <TableView fx:id="tvValidacion" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="tcCodigo" prefWidth="100.0" text="Código" />
            <TableColumn fx:id="tcProducto" prefWidth="300.0" text="Producto" />
            <TableColumn fx:id="tcCantidadSistema" prefWidth="150.0" text="Cantidad Sistema" />
            <TableColumn fx:id="tcCantidadFisica" prefWidth="150.0" text="Cantidad Física" />
            <TableColumn fx:id="tcDiferencia" prefWidth="150.0" text="Diferencia" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_RIGHT" spacing="15.0" />
   </children>
</VBox>
