<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import java.lang.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="699.0" prefWidth="600.0" style="-fx-background-color: #323232;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pizzeria.pae.vistas.controlador.ProductoFormViewController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label text="Datos del Producto" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <GridPane hgap="15.0" vgap="15.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="100.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
               </columnConstraints>
               <children>
                  <Label text="*Código:" textFill="#d1cfcf" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="tfCodigo" style="-fx-background-color: #505050; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  
                  <Label text="*Nombre:" textFill="#d1cfcf" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="tfNombreProducto" style="-fx-background-color: #505050; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="*Descripción:" textFill="#d1cfcf" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextArea fx:id="tfDescripcion" prefRowCount="3" style="-fx-background-color: #505050; -fx-control-inner-background: #505050; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <Label text="*Precio:" textFill="#d1cfcf" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <TextField fx:id="tfPrecio" style="-fx-background-color: #505050; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  
                  <Label text="*Cantidad:" textFill="#d1cfcf" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                  <TextField fx:id="tfCantidad" style="-fx-background-color: #505050; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  
                  <Label text="Restricciones:" textFill="#d1cfcf" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                  <TextField fx:id="tfRestricciones" style="-fx-background-color: #505050; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="5" />
               </children>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
            </GridPane>
            <HBox alignment="CENTER" prefHeight="15.0" prefWidth="560.0" spacing="30.0">
               <children>
                  <Label text="*Tipo:" textFill="WHITE" />
                  <RadioButton fx:id="rdConsumo" mnemonicParsing="false" text="Consumo" textFill="WHITE">
                     <toggleGroup>
                        <ToggleGroup fx:id="rdTipo" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="rdInsumo" mnemonicParsing="false" text="Insumo" textFill="WHITE" toggleGroup="$rdTipo" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                   <Label text="*Foto del producto:" textFill="#d1cfcf" />
                   <Button onAction="#clickSeleccionarImagen" style="-fx-background-color: #404040; -fx-text-fill: white;" text="Seleccionar Imagen" />
                  <ImageView fx:id="ivFoto" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
               </children>
            </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets top="20.0" />
               </padding>
               <children>
                  <Button onAction="#clickGuardar" prefWidth="100" style="-fx-background-color: #218c74; -fx-background-radius: 8;" text="Guardar" textFill="WHITE" />
                  <Button onAction="#clickCancelar" prefWidth="100" style="-fx-background-color: #505050; -fx-background-radius: 8;" text="Cancelar" textFill="WHITE" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
