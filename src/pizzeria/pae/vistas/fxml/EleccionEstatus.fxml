<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="250.0" prefWidth="300.0" spacing="50.0" style="-fx-background-color: #505050;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pizzeria.pae.vistas.controlador.EleccionEstatusController">

    <padding>
        <Insets bottom="30.0" left="15.0" right="15.0" top="30.0" />
    </padding>

    <children>

        <HBox spacing="10.0">

            <children>

                <Label text="Folio:" textFill="WHITE" />

                <Label fx:id="lblFolio" prefHeight="21.0" prefWidth="215.0" textFill="WHITE" />

            </children>

        </HBox>

        <ComboBox fx:id="cmbEstatus" prefWidth="200.0" promptText="Seleccionar estatus" />

        <Button fx:id="btnGuardar" onAction="#clickGuardarEstatus" prefWidth="120.0" style="-fx-background-color: #404040;" text="Guardar" textFill="WHITE" />

    </children>

</VBox>
